{
    "java.project.referencedLibraries": [
        "src/Lib/**/*.jar"
    ],
    "java.project.sourcePaths": [
        "src"
    ],
    "java.project.outputPath": "build/classes",
    "java.debug.settings": {
        "showHex": true
    },
    "[java]": {
        "editor.defaultFormatter": "redhat.java",
        "editor.formatOnSave": true
    }
}